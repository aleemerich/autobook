# ===========================================================================
# ⚙️ ACTIVE LLM CONTROL PANEL
# ===========================================================================
# Active provider (can be: anthropic, openai, gemini, openrouter)
AUTOBOOK_PROVIDER=openrouter

# Timeout for pipeline subprocess runs (in seconds)
AUTOBOOK_PIPELINE_TIMEOUT=3600

# Optional fine-grained timeouts overrides (leave blank or uncomment to customize)
# AUTOBOOK_REVISION_TIMEOUT=1200
# AUTOBOOK_EVAL_TIMEOUT=600
# AUTOBOOK_EXPORT_TIMEOUT=600

# Console log truncation limit (in characters)
AUTOBOOK_LOG_TRUNCATE_LIMIT=300

# Base language of the book generation (can be: EN or PT-BR)
AUTOBOOK_LANGUAGE=PT-BR

# Genre/Literary style of the book (can be: drama, light_novel, crime_mystery)
AUTOBOOK_GENRE=drama

# Writer model (used for drafting chapters and fast revisions)
# Recommended defaults:
# - anthropic: claude-sonnet-4-6
# - openai: gpt-4o
# - gemini: gemini-1.5-pro
# - openrouter: openrouter/owl-alpha
AUTOBOOK_WRITER_MODEL=openrouter/owl-alpha

# Judge model (used for mechanical/LLM evaluations and slop detection)
# Supports a comma-separated list of models for dynamic failover/fallback.
# Example: nvidia/nemotron-3-super-120b-a12b:free,openrouter/owl-alpha,openrouter/free
AUTOBOOK_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free,openrouter/owl-alpha,openrouter/free

# Deep analysis model (Claude Opus — used in the Phase 3b Opus Loop)
AUTOBOOK_REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Base API URL (optional - automatically configured by llm.py based on provider)
# AUTOBOOK_API_BASE_URL=https://api.anthropic.com

# ===========================================================================
# 🔑 PROVIDER API KEYS (Fill in the keys for the ones you use)
# ===========================================================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
OPENROUTER_API_KEY=sk-or-v1-...

# ===========================================================================
# 🎨 MEDIA KEYS (OPTIONAL)
# ===========================================================================
# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook narration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here


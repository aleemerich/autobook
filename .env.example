# ===========================================================================
# ⚙️ PAINEL DE CONTROLE DO LLM ATIVO
# ===========================================================================
# Provedor ativo (pode ser: anthropic, openai, gemini, openrouter)
AUTOBOOK_PROVIDER=anthropic

# Idioma base da geração do livro (pode ser: EN ou PT-BR)
AUTOBOOK_LANGUAGE=PT-BR

# Gênero/Estilo literário do livro (pode ser: drama, light_novel, crime_mystery)
AUTOBOOK_GENRE=drama

# Modelo do escritor (usado para rascunhos de capítulos e revisões rápidas)
# Padrões recomendados:
# - anthropic: claude-sonnet-4-6
# - openai: gpt-4o
# - gemini: gemini-1.5-pro
# - openrouter: google/gemini-flash-1.5 (ou similar)
AUTOBOOK_WRITER_MODEL=claude-sonnet-4-6

# Modelo do juiz (usado para avaliações mecânicas/LLM e slop detection)
# Deve ser idealmente diferente ou igual de acordo com custos.
AUTOBOOK_JUDGE_MODEL=claude-sonnet-4-6

# Modelo de análise profunda (Claude Opus — usado no Opus Loop da Fase 3b)
AUTOBOOK_REVIEW_MODEL=claude-opus-4-6

# URL base da API (opcional - configurado automaticamente pelo llm.py baseado no provedor)
# AUTOBOOK_API_BASE_URL=https://api.anthropic.com

# ===========================================================================
# 🔑 CHAVES DE API DOS PROVEDORES (Preencha as chaves dos que você usa)
# ===========================================================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
OPENROUTER_API_KEY=sk-or-v1-...

# ===========================================================================
# 🎨 CHAVES DE MÍDIA (OPCIONAIS)
# ===========================================================================
# fal.ai key para geração de imagens (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key para narração do audiobook
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

